# xchain-regtest-miner configuration — copy to .env and fill in values.
# Auto-mines mempool transactions for regtest environments. Intended for
# development/CI only; the resolved network must be regtest.

# Required: coin and network. The network segment must resolve to regtest
# (e.g. bitcoin-regtest, litecoin-regtest, dogecoin-regtest).
NETWORK=bitcoin-regtest

# Required: coin node RPC connection.
NODE_URL=127.0.0.1
NODE_PORT=8332
NODE_USER=rpcuser
NODE_PASSWORD=rpcpass

# Optional: JSON-RPC API port the miner listens on.
REGTEST_MINER_API_PORT=3003

# Optional: coin node RPC timeout in ms (default 60000).
# NODE_RPC_TIMEOUT=60000
